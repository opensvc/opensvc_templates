# The response headers of every location of nginx.conf. nginx drops the
# add_header directives of the server in a location setting its own, so such
# a location includes this file again. No Content-Security-Policy here: the
# web interface brings its own; X-Frame-Options stands for the frame-ancestors
# a <meta> policy cannot set.
add_header Strict-Transport-Security "max-age=63072000" always;
add_header X-Content-Type-Options "nosniff" always;
add_header Referrer-Policy "same-origin" always;
add_header X-Frame-Options "DENY" always;
