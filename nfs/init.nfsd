#!/usr/bin/bash

start() {
        /usr/sbin/exportfs -r || exit 1
        /usr/sbin/rpc.nfsd $NFSTHREADS || exit 1
        if systemctl -q is-active gssproxy
        then
                systemctl reload gssproxy
        fi
}

stop() {
        /usr/sbin/rpc.nfsd 0
        /usr/sbin/exportfs -au
        /usr/sbin/exportfs -f
}

status() {
        threads=$(</proc/fs/nfsd/threads)
        if [ "$threads" -eq "0" ]
        then
                echo "no threads running" >&2
                return 1
        else
                return 0
        fi
}

case "$1" in
start)
        start
        ;;
stop)
        stop
        ;;
restart)
        stop
        start
        ;;
status)
        status
        ;;
*)
        echo "usage $0 { start | stop | restart | status }"
        exit 1
        ;;
esac
