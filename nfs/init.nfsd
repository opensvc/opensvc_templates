#!/usr/bin/bash

start() {
        /usr/sbin/exportfs -r || exit 1
        /usr/sbin/rpc.nfsd || exit 1
        if systemctl -q is-active gssproxy
        then
                systemctl reload gssproxy
        fi
}

stop() {
        /usr/sbin/rpc.nfsd 0
        /usr/sbin/exportfs -au
        /usr/sbin/exportfs -f
}

status() {
        if [ ! -r /proc/fs/nfsd/threads ] || [ "$(</proc/fs/nfsd/threads)" -eq 0 ]
        then
                echo "no threads running" >&2
                return 1
        fi

	return 0
}

case "$1" in
start)
        start
        ;;
stop)
        stop
        ;;
restart)
        stop
        start
        ;;
status)
        status
        ;;
*)
        echo "usage $0 { start | stop | restart | status }"
        exit 1
        ;;
esac
